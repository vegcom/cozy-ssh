# ~/.ssh/config

# Operationn
AddKeysToAgent yes
BatchMode yes
VisualHostKey no

# General host settings
PermitLocalCommand yes
RequestTTY yes
StrictHostKeyChecking accept-new

# Keepalive
ServerAliveInterval 16
ServerAliveCountMax 16

# General imports
Include ssh_config.d/*.conf

# Parsing
CanonicalizeHostname yes
CanonicalizeMaxDots 1
CanonicalizeFallbackLocal yes

# Allow for fallbacks:
#     see helpers/rotate.py
IdentityFile ~/.ssh/keys/id_rsa
IdentityFile ~/.ssh/keys/id_ed25519
# Backup keys always stored as such
IdentityFile ~/.ssh/keys/id_rsa.bak
IdentityFile ~/.ssh/keys/id_ed25519.bak

Match final
  # Log level, for overrides check:
  Include ssh_config.d/opt/logging.conf
  # Terminal Multiplexing
  Include ssh_config.d/opt/multiplex.conf
  # Environment variables general
  Include ssh_config.d/opt/envs.conf
  # OS detection tooling
  Include ssh_config.d/opt/os_detection.conf
